#!/usr/bin/env bash
# Cool Arch quick install - adds the coolguy565 repo, then runs cool-install (archinstall-based).
# Usage: curl -fsSL https://coolguy565.github.io/quick-install | bash
set -euo pipefail

REPO_NAME="coolguy565"
REPO_KEY="E36138CC5F015492A1D620581C4F28ACC1A18345"
REPO_URL="https://github.com/coolguy565/coolguy565.github.io/releases/download/coolguy565"
COOL_INSTALL_URL="https://coolguy565.github.io/cool-install"
SELF_URL="https://coolguy565.github.io/quick-install"

# make sure figlet is available for the banner
if ! command -v figlet >/dev/null 2>&1; then
  (command -v sudo >/dev/null 2>&1 && sudo pacman -Sy --noconfirm figlet >/dev/null 2>&1) \
    || pacman -Sy --noconfirm figlet >/dev/null 2>&1 || true
fi

banner() {
  if command -v figlet >/dev/null 2>&1; then
    tput setaf 4; figlet -f slant "Cool Arch"; tput sgr0
  else
    tput setaf 4
    cat <<'BANNER'
   ______            __   ___              __  
  / ____/___  ____  / /  /   |  __________/ /_ 
 / /   / __ \/ __ \/ /  / /| | / ___/ ___/ __ \
/ /___/ /_/ / /_/ / /  / ___ |/ /  / /__/ / / /
\____/\____/\____/_/  /_/  |_/_/   \___/_/ /_/ 
                                               
BANNER
    tput sgr0
  fi
}
banner

# self-elevate to root
if [[ $EUID -ne 0 ]]; then
  exec sudo bash -c "$(curl -fsSL "$SELF_URL")"
fi

# add the coolguy565 repo
grep -q "^\[$REPO_NAME\]" /etc/pacman.conf || {
  printf '\n[%s]\nSigLevel = Required DatabaseOptional\nServer = %s\n' "$REPO_NAME" "$REPO_URL" >> /etc/pacman.conf
  curl -fsSL -o /tmp/cool.asc "$REPO_URL/$REPO_NAME.asc"
  pacman-key --add /tmp/cool.asc
  pacman-key --lsign-key "$REPO_KEY"
}
pacman -Syy

# update ONLY critical packages with targeted -S (a full -Syu would download
# every updated package, bigger than the ISO's 256M airootfs/cowspace)
#   python:        older ISOs ship python < 3.14, but our vendored archinstall
#                  (archinstall-cool) targets 3.14+ syntax
#   python-pyparted / python-pydantic / python-cryptography:
#                  MUST be named explicitly - the ISO's copies are built for the
#                  OLD python, so upgrading python alone leaves them orphaned in
#                  the old site-packages (No module named 'parted')
#   curl:          all our downloads depend on it
#   archinstall-cool: our trimmed, vendored archinstall (never the ISO's)
pacman -S --needed --noconfirm python python-pyparted python-pydantic python-cryptography curl archinstall-cool

# verify the python runtime deps are actually importable before launching
if ! PYTHONPATH=/opt/cool-archinstall python3 - <<'PY'; then
import sys
print(f"python {sys.version.split()[0]}")
ok = True
for m in ("parted", "pydantic", "cryptography"):
    try:
        __import__(m)
        print(f"  {m}: OK")
    except Exception as e:
        print(f"  {m}: {type(e).__name__}: {e}")
        ok = False
sys.exit(0 if ok else 1)
PY
  echo "ERROR: python runtime deps are broken." >&2
  echo "Paste the output above for diagnosis." >&2
  exit 1
fi

# fetch and run the archinstall-based installer
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
curl -fsSL "$COOL_INSTALL_URL" -o "$tmp"
exec python3 "$tmp" < /dev/tty
