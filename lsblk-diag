#!/usr/bin/env python3
# lsblk diagnostic for the cool-install failure.
# Usage: curl -fsSL https://coolguy565.github.io/lsblk-diag | python3
import os
import shutil
import subprocess
import sys

print("== lsblk diagnostic ==")
print("python      :", sys.version.split()[0])
print("cool-dir    :", os.path.isdir("/opt/cool-archinstall"))

cool = "/opt/cool-archinstall"
if os.path.isdir(cool) and cool not in sys.path:
    sys.path.insert(0, cool)

fields = []
try:
    import archinstall
    print("archinstall  :", archinstall.__file__)
    from archinstall.lib.models.device import LsblkInfo
    fields = LsblkInfo.fields()
    print("fields       :", fields)
except Exception as e:
    print("archinstall  : FAILED ->", type(e).__name__, e)

if not fields:
    fields = ["name", "path"]

cols = ",".join(fields)
cmd = ["lsblk", "--json", "--bytes", "--output", cols]
print("cmd          :", " ".join(cmd))
print("lsblk        :", shutil.which("lsblk"))
try:
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    print("rc           :", r.returncode)
    print("stderr       :", (r.stderr or "").strip()[:300])
    print("stdout[:120] :", (r.stdout or "").strip()[:120])
except Exception as e:
    print("run error    :", type(e).__name__, e)

try:
    v = subprocess.run(["lsblk", "--version"], capture_output=True, text=True, timeout=10)
    print("version      :", (v.stdout or v.stderr or "").strip())
except Exception as e:
    print("version      :", type(e).__name__, e)

print("== end ==")
