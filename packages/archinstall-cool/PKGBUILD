pkgname=archinstall-cool
pkgver=4.4
pkgrel=5
pkgdesc="Trimmed archinstall (core install path only) for the Cool Arch installer; installed to /opt/cool-archinstall"
arch=('any')
url="https://github.com/coolguy565/coolguy565.github.io"
license=('GPL-3.0-only')
depends=(
  'arch-install-scripts'
  'btrfs-progs'
  'coreutils'
  'cryptsetup'
  'dosfstools'
  'e2fsprogs'
  'glibc'
  'kbd'
  'lvm2'
  'pciutils'
  'procps-ng'
  'python'
  'python-cryptography'
  'python-pydantic'
  'python-pyparted'
  'systemd'
  'util-linux'
)
source=('archinstall.tar.gz')
sha256sums=('SKIP')

package() {
  install -dm755 "$pkgdir/opt/cool-archinstall"
  cp -r "$srcdir/archinstall" "$pkgdir/opt/cool-archinstall/archinstall"
}
